#version 450
// Probe kernel for bench_barrier: each invocation updates its own element.
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;

layout(std430, binding = 0) buffer Data { uint data[]; };
layout(push_constant) uniform PushConstants { uint count; } pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;
  uint v = data[i];
  for (int k = 0; k < 4; ++k) v = v * 1664525u + 1013904223u;
  data[i] = v;
}
