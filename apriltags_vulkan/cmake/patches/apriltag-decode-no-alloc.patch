+// matd_plu()'s singular flag for a 3x3 matrix, computed the same way on the stack.
+static int plu_singular3(const matd_t *a)
+{
+    double lu[3][3];
+    for (int i = 0; i < 3; i++)
+        for (int j = 0; j < 3; j++)
+            lu[i][j] = MATD_EL(a, i, j);
+    int singular = 0;
+    for (int j = 0; j < 3; j++) {
+        for (int i = 0; i < 3; i++) {
+            int kmax = i < j ? i : j;
+            double acc = 0;
+            for (int k = 0; k < kmax; k++)
+                acc += lu[i][k] * lu[k][j];
+            lu[i][j] -= acc;
+        }
+        int p = j;
+        for (int i = j + 1; i < 3; i++) {
+            if (fabs(lu[i][j]) > fabs(lu[p][j]))
+                p = i;
+        }
+        if (p != j) {
+            for (int k = 0; k < 3; k++) {
+                double tmp = lu[p][k];
+                lu[p][k] = lu[j][k];
+                lu[j][k] = tmp;
+            }
+        }
+        double LUjj = lu[j][j];
+        if (fabs(LUjj) < MATD_EPS)
+            singular = 1;
+        if (LUjj != 0) {
+            LUjj = 1.0 / LUjj;
+            for (int i = j + 1; i < 3; i++)
+                lu[i][j] *= LUjj;
+        }
+    }
+    return singular;
+}
