# Opt-in compiler tuning of the vkapriltag library: link-time optimisation, target options, extra code
# generation flags and profile-guided optimisation. Every option is off by default, so the default build is
# portable and its output is the reference output.

option(VKAPRILTAG_LTO "Link-time optimisation of the library and the in-tree tools (gcc/clang -flto, MSVC /GL /LTCG)" OFF)
set(VKAPRILTAG_TUNE "" CACHE STRING
    "Target flags for the library, for example -mcpu=cortex-a76, -march=x86-64-v3 or /arch:AVX2; the binary then needs that CPU")
set(VKAPRILTAG_CODEGEN "" CACHE STRING "Extra code generation flags for the library (separated by ;)")
set(VKAPRILTAG_PGO "OFF" CACHE STRING "Profile-guided optimisation: OFF, GENERATE (instrumented build) or USE (build with the profile)")
set_property(CACHE VKAPRILTAG_PGO PROPERTY STRINGS OFF GENERATE USE)
set(VKAPRILTAG_PGO_DIR "${CMAKE_BINARY_DIR}/pgo" CACHE PATH "Where the profile data is written (GENERATE) and read (USE)")

if(VKAPRILTAG_PGO AND NOT VKAPRILTAG_PGO STREQUAL "OFF" AND MSVC)
  set(VKAPRILTAG_LTO ON CACHE BOOL "" FORCE)
endif()

if(VKAPRILTAG_LTO)
  include(CheckIPOSupported)
  check_ipo_supported(RESULT VKAPRILTAG_IPO_OK OUTPUT VKAPRILTAG_IPO_MSG LANGUAGES CXX)
  if(NOT VKAPRILTAG_IPO_OK)
    message(FATAL_ERROR "VKAPRILTAG_LTO=ON, but the compiler does not support it: ${VKAPRILTAG_IPO_MSG}")
  endif()
  set(CMAKE_INTERPROCEDURAL_OPTIMIZATION ON)
endif()

# Applies the options above to a library target.
function(vkapriltag_tune_target target)
  set(flags "")
  if(VKAPRILTAG_TUNE)
    separate_arguments(tune NATIVE_COMMAND "${VKAPRILTAG_TUNE}")
    list(APPEND flags ${tune})
  endif()
  list(APPEND flags ${VKAPRILTAG_CODEGEN})
  set(link_flags "")
  if(VKAPRILTAG_LTO AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    # Fat objects: the installed archive also links into programs built without -flto.
    list(APPEND flags -ffat-lto-objects)
  endif()
  if(NOT VKAPRILTAG_PGO STREQUAL "OFF")
    if(MSVC)
      file(TO_NATIVE_PATH "${VKAPRILTAG_PGO_DIR}/vkapriltag.pgd" pgd)
      if(VKAPRILTAG_PGO STREQUAL "GENERATE")
        list(APPEND link_flags /LTCG /GENPROFILE:PGD=${pgd})
      else()
        list(APPEND link_flags /LTCG /USEPROFILE:PGD=${pgd})
      endif()
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
      if(VKAPRILTAG_PGO STREQUAL "GENERATE")
        list(APPEND flags -fprofile-generate=${VKAPRILTAG_PGO_DIR} -fprofile-update=prefer-atomic)
        list(APPEND link_flags -fprofile-generate=${VKAPRILTAG_PGO_DIR})
      else()
        list(APPEND flags -fprofile-use=${VKAPRILTAG_PGO_DIR} -fprofile-correction -Wno-missing-profile)
      endif()
    endif()
  endif()
  if(flags)
    target_compile_options(${target} PRIVATE ${flags})
  endif()
  if(link_flags)
    target_link_options(${target} INTERFACE ${link_flags})
  endif()
endfunction()
