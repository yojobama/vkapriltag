#version 450
// As uf_init.comp, with Thresholded stored as uint8_t per pixel.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(std430, binding = 1) readonly buffer Thresholded { uint8_t thresholded[]; };
#define THRESHOLDED_AT(i) (thresholded[(i)])

#include "uf_init_body.glsl"
