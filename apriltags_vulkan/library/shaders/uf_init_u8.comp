#version 450
// uf_init.comp with a uint8_t Thresholded; Parent stays uint32.
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x_id = 0, local_size_x = 16, local_size_y_id = 1, local_size_y = 16) in;

layout(std430, binding = 0) writeonly buffer Parent { uint parent[]; };
layout(std430, binding = 1) readonly buffer Thresholded { uint8_t thresholded[]; };

layout(push_constant) uniform PushConstants {
  uint width;
  uint height;
} pc;

void main() {
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  if (x >= pc.width || y >= pc.height) return;
  uint i = y * pc.width + x;

  uint v = uint(thresholded[i]);
  bool join_left = (v != 127u) && (x > 0u) && (uint(thresholded[i - 1u]) == v);
  parent[i] = join_left ? (i - 1u) : i;
}
