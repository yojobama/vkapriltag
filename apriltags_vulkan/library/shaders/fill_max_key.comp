#version 450
// Writes the sentinel "maximum" key into the [begin, end) tail of the sort
// buffers, so that the padding needed to round a frame's element count up to
// a power of two for the bitonic network sorts to the very end and is ignored
// by everything downstream.
//
// This used to be dispatched over the entire worst-case capacity (~2M entries
// at 1080p) before compaction had even run. Now that the sort is sized to the
// number of points a frame actually produced, only the gap between that count
// and the next power of two needs filling - at most n-1 entries, and
// typically a few thousand rather than two million.
layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) writeonly buffer KeysHi { uint keys_hi[]; };
layout(std430, binding = 1) writeonly buffer KeysLo { uint keys_lo[]; };
layout(std430, binding = 2) writeonly buffer Payload { uint payload[]; };

layout(push_constant) uniform PushConstants {
  uint begin;
  uint end;
} pc;

void main() {
  uint i = pc.begin + gl_GlobalInvocationID.x;
  if (i >= pc.end) return;
  keys_hi[i] = 0xFFFFFFFFu;
  keys_lo[i] = 0xFFFFFFFFu;
  // A payload index no gather can dereference: gather_generic.comp bounds
  // checks against the real element count, so these entries are skipped.
  payload[i] = 0xFFFFFFFFu;
}
