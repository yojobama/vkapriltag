#version 450
// A9 stage 3: GPU port of DoFitLines' 7-tap Gaussian filter + peak
// detection + top-10 peak selection (QuadDecode.cpp, FitQuadForBlob lines
// ~362-397), built on stage 2's error[] (compute_window_error.comp).
//
// One workgroup per blob, sized to EXACTLY one subgroup (see
// compute_moments_prefix.comp's comment for why - shared-memory/barrier-
// based cooperation measured catastrophically slow on Mali). Peak
// detection is embarrassingly parallel (each lane's strided subset of
// points is independent once error[] exists); the top-10 selection is a
// two-level reduction done entirely with subgroupShuffle, no shared
// memory:
//   1. Each lane maintains its OWN top-10 among the peaks it personally
//      finds (the streaming "replace worst on strict improvement" trick -
//      still correct here since a fixed lane's strided sequence visits
//      points in strictly ascending index order).
//   2. Lane 0 gathers every other lane's local top-10 via subgroupShuffle
//      (called uniformly by all lanes each iteration, so every lane's
//      values are read on the same instruction regardless of which one
//      "owns" the final merge) and folds them into a single final top-10
//      with the same streaming trick. A lane that doesn't appear in its
//      own local top-10 can never be in the true global top-10 either
//      (something already beat it 10 times over within its own
//      partition), so no candidate is lost by only keeping each lane's
//      local top-10.
// Step 2's merge does NOT tie-break by index the way step 1 naturally
// does (gather order is by lane, not by global point index) - exact float
// ties are rare enough that this is accepted the same way as this stage's
// other precision-driven wobble (see the earlier bit-exactness-vs-
// tolerance discussion for stage 2).
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

layout(local_size_x_id = 0, local_size_x = 16) in;

layout(std430, binding = 0) readonly buffer BlobPointOffsets { uint blob_point_offsets[]; };
layout(std430, binding = 1) readonly buffer ErrorIn { float error_in[]; };
// 10 uints per blob - the selected point indices, ascending, valid up to
// num_selected[blob] (garbage beyond that, matching CPU's untouched tail
// of point_indices when K < kNMaxima).
layout(std430, binding = 2) writeonly buffer PointIndicesOut { uint point_indices_out[]; };
// 1 uint per blob: K = min(peaks found, 10), or 0 when K < 4 (FitQuadForBlob
// returns invalid in that case - see the "if (K < 4) return result;" guard).
layout(std430, binding = 3) writeonly buffer NumSelectedOut { uint num_selected_out[]; };

layout(push_constant) uniform PushConstants {
  uint num_blobs;
} pc;

const uint kNMaxima = 10u;
const int kFilterHalf = 3;
const float kFilterCoefficients[7] =
    float[7](0.01110899634659290314, 0.13533528149127960205, 0.60653066635131835938, 1.0,
             0.60653066635131835938, 0.13533528149127960205, 0.01110899634659290314);

// The 7-tap circular filter at one index, mirroring the CPU's per-i
// convolution exactly (same coefficient order, same accumulation order).
float Filtered(uint begin, uint n, uint i) {
  uint idx = (i >= uint(kFilterHalf)) ? (i - uint(kFilterHalf)) : (i + n - uint(kFilterHalf));
  float accumulated = 0.0;
  for (int j = 0; j < 7; ++j) {
    accumulated += error_in[begin + idx] * kFilterCoefficients[j];
    idx = (idx + 1u == n) ? 0u : (idx + 1u);
  }
  return accumulated;
}

void main() {
  uint b = gl_WorkGroupID.x;
  if (b >= pc.num_blobs) return;

  uint begin = (b == 0u) ? 0u : blob_point_offsets[b - 1u];
  uint end = blob_point_offsets[b];
  uint n = end - begin;
  uint tid = gl_SubgroupInvocationID;
  uint sg_size = gl_SubgroupSize;

  float best_val[kNMaxima];
  uint best_idx[kNMaxima];
  uint count = 0u;

  if (n >= 4u) {
    for (uint i = tid; i < n; i += sg_size) {
      uint i_before = (i == 0u) ? (n - 1u) : (i - 1u);
      uint i_after = (i + 1u == n) ? 0u : (i + 1u);
      float cur = Filtered(begin, n, i);
      float before = Filtered(begin, n, i_before);
      float after = Filtered(begin, n, i_after);
      if (!(cur > before && cur > after)) continue;

      float peak_value = -cur;
      if (count < kNMaxima) {
        best_val[count] = peak_value;
        best_idx[count] = i;
        ++count;
      } else {
        uint worst_slot = 0u;
        float worst_val = best_val[0];
        for (uint k = 1u; k < kNMaxima; ++k) {
          if (best_val[k] > worst_val) {
            worst_val = best_val[k];
            worst_slot = k;
          }
        }
        if (peak_value < worst_val) {
          best_val[worst_slot] = peak_value;
          best_idx[worst_slot] = i;
        }
      }
    }
  }

  // Merge every lane's local top-10 into lane 0's final top-10, using only
  // subgroupShuffle (uniformly called by every lane each iteration - no
  // shared memory, no barrier).
  float final_val[kNMaxima];
  uint final_idx[kNMaxima];
  uint final_count = 0u;

  for (uint src = 0u; src < sg_size; ++src) {
    uint src_count = subgroupShuffle(count, src);  // uniform across all lanes
    for (uint k = 0u; k < src_count; ++k) {
      float v = subgroupShuffle(best_val[k], src);
      uint idx = subgroupShuffle(best_idx[k], src);
      if (tid == 0u) {
        if (final_count < kNMaxima) {
          final_val[final_count] = v;
          final_idx[final_count] = idx;
          ++final_count;
        } else {
          uint worst_slot = 0u;
          float worst_val = final_val[0];
          for (uint j = 1u; j < kNMaxima; ++j) {
            if (final_val[j] > worst_val) {
              worst_val = final_val[j];
              worst_slot = j;
            }
          }
          if (v < worst_val) {
            final_val[worst_slot] = v;
            final_idx[worst_slot] = idx;
          }
        }
      }
    }
  }

  if (tid != 0u) return;

  if (final_count < 4u) {
    num_selected_out[b] = 0u;
    return;
  }

  // std::sort(point_indices.begin(), point_indices.begin() + K) -
  // ascending by point index. final_count <= 10, plain insertion sort.
  for (uint i = 1u; i < final_count; ++i) {
    uint key = final_idx[i];
    uint j = i;
    while (j > 0u && final_idx[j - 1u] > key) {
      final_idx[j] = final_idx[j - 1u];
      --j;
    }
    final_idx[j] = key;
  }

  num_selected_out[b] = final_count;
  uint out_base = b * kNMaxima;
  for (uint k = 0u; k < final_count; ++k) point_indices_out[out_base + k] = final_idx[k];
}
