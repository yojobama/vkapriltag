#version 450
// A9 stage 3: GPU port of DoFitLines' 7-tap Gaussian filter + peak
// detection + top-10 peak selection (QuadDecode.cpp, FitQuadForBlob lines
// ~362-397), built on stage 2's error[] (compute_window_error.comp).
//
// One invocation per blob (single-thread, like stage 1 - correctness
// first, not yet the final launch geometry). filtered[i] is recomputed
// from scratch (a fresh 7-tap convolution over error[]) every time it's
// needed rather than materialized into a per-blob array: it's a pure
// function of error[], so this is redundant work (up to 3x, since a point
// and its two neighbors each need their own filtered value) but needs no
// blob-size-dependent scratch storage at all - unlike stage 1/2, this
// stage has no upper bound on blob size to worry about.
//
// Peak selection mirrors CPU's `peaks.emplace_back(-cur, i)` followed by
// `std::stable_sort` (ascending by -cur, i.e. strongest peaks first) and
// taking the first min(peaks.size(), 10) - WITHOUT ever materializing the
// full peaks list. Processing points in ascending i and maintaining a
// bounded best-10 list, replacing its current worst entry only on STRICT
// improvement (never on a tie), exactly reproduces stable_sort's tie
// rule: two peaks of equal value keep their relative (ascending index)
// order, so the earlier one is always the one still present when a later,
// equal-valued one arrives and correctly fails to displace it.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x_id = 0, local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer Ranges { uvec2 ranges[]; };
layout(std430, binding = 1) readonly buffer ErrorIn { float error_in[]; };
// 10 uints per blob - the selected point indices, ascending, valid up to
// num_selected[blob] (garbage beyond that, matching CPU's untouched tail
// of point_indices when K < kNMaxima).
layout(std430, binding = 2) writeonly buffer PointIndicesOut { uint point_indices_out[]; };
// 1 uint per blob: K = min(peaks found, 10), or 0 when K < 4 (FitQuadForBlob
// returns invalid in that case - see the "if (K < 4) return result;" guard).
layout(std430, binding = 3) writeonly buffer NumSelectedOut { uint num_selected_out[]; };

layout(push_constant) uniform PushConstants {
  uint num_blobs;
} pc;

const int kFilterHalf = 3;
const float kFilterCoefficients[7] =
    float[7](0.01110899634659290314, 0.13533528149127960205, 0.60653066635131835938, 1.0,
             0.60653066635131835938, 0.13533528149127960205, 0.01110899634659290314);

// The 7-tap circular filter at one index, mirroring the CPU's per-i
// convolution exactly (same coefficient order, same accumulation order).
float Filtered(uint begin, uint n, uint i) {
  uint idx = (i >= uint(kFilterHalf)) ? (i - uint(kFilterHalf)) : (i + n - uint(kFilterHalf));
  float accumulated = 0.0;
  for (int j = 0; j < 7; ++j) {
    accumulated += error_in[begin + idx] * kFilterCoefficients[j];
    idx = (idx + 1u == n) ? 0u : (idx + 1u);
  }
  return accumulated;
}

void main() {
  uint b = gl_GlobalInvocationID.x;
  if (b >= pc.num_blobs) return;

  uint begin = ranges[b].x;
  uint end = ranges[b].y;
  uint n = end - begin;

  const uint kNMaxima = 10u;
  float best_val[kNMaxima];
  uint best_idx[kNMaxima];
  uint count = 0u;

  if (n >= 4u) {
    for (uint i = 0u; i < n; ++i) {
      uint i_before = (i == 0u) ? (n - 1u) : (i - 1u);
      uint i_after = (i + 1u == n) ? 0u : (i + 1u);
      float cur = Filtered(begin, n, i);
      float before = Filtered(begin, n, i_before);
      float after = Filtered(begin, n, i_after);
      if (!(cur > before && cur > after)) continue;

      float peak_value = -cur;
      if (count < kNMaxima) {
        best_val[count] = peak_value;
        best_idx[count] = i;
        ++count;
      } else {
        uint worst_slot = 0u;
        float worst_val = best_val[0];
        for (uint k = 1u; k < kNMaxima; ++k) {
          if (best_val[k] > worst_val) {
            worst_val = best_val[k];
            worst_slot = k;
          }
        }
        if (peak_value < worst_val) {
          best_val[worst_slot] = peak_value;
          best_idx[worst_slot] = i;
        }
      }
    }
  }

  if (count < 4u) {
    num_selected_out[b] = 0u;
    return;
  }

  // std::sort(point_indices.begin(), point_indices.begin() + K) - ascending
  // by point index (not by peak value, which was only needed to pick the
  // K survivors). count <= 10, so a plain insertion sort is fine.
  for (uint i = 1u; i < count; ++i) {
    uint key = best_idx[i];
    uint j = i;
    while (j > 0u && best_idx[j - 1u] > key) {
      best_idx[j] = best_idx[j - 1u];
      --j;
    }
    best_idx[j] = key;
  }

  num_selected_out[b] = count;
  uint out_base = b * kNMaxima;
  for (uint k = 0u; k < count; ++k) {
    point_indices_out[out_base + k] = best_idx[k];
  }
}
