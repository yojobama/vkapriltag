#version 450
// Initialises the raw per-blob extents accumulator before reduce_extents_hash.comp.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) writeonly buffer Extents { MinMaxExtentsGpu extents[]; };

layout(push_constant) uniform PushConstants {
  uint capacity;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.capacity) return;

  MinMaxExtentsGpu e;
  e.min_x = 2147483647;
  e.min_y = 2147483647;
  e.max_x = -2147483647;
  e.max_y = -2147483647;
  e.count = 0u;
  e.gx_sum = 0;
  e.gy_sum = 0;
  e.pxgx_plus_pygy_sum = 0;
  extents[i] = e;

  // Every private copy needs the same identity because merge_extents.comp folds
  // all of them: min/max start at +/-INT_MAX, sums at 0.
  if (i < kPrivateExtentsBlobs) {
    for (uint c = 1u; c < kExtentsCopies; ++c) {
      extents[ExtentsSlot(i, c, pc.capacity)] = e;
    }
  }
}
