#version 450
// Initializes the raw per-blob extents accumulator array before
// reduce_extents.comp runs its atomic min/max/sum reduction.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) writeonly buffer Extents { MinMaxExtentsGpu extents[]; };

layout(push_constant) uniform PushConstants {
  uint capacity;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.capacity) return;

  MinMaxExtentsGpu e;
  e.min_x = 2147483647;
  e.min_y = 2147483647;
  e.max_x = -2147483647;
  e.max_y = -2147483647;
  e.count = 0u;
  e.gx_sum = 0;
  e.gy_sum = 0;
  e.pxgx_plus_pygy_sum = 0;
  extents[i] = e;

  // Every private copy this blob can be accumulated into needs the same
  // identity, because merge_extents.comp folds all of them unconditionally.
  // One invocation per blob writing kExtentsCopies-1 extra entries keeps this
  // sized by the frame's real blob count (the dispatch is indirect) instead
  // of by the replicated capacity - a few hundred blobs, not 94k slots.
  //
  // Identity, not "zero": min/max fold correctly only against +/-INT_MAX,
  // and the sums fold correctly only against 0. A copy that is never written
  // therefore contributes nothing, which is what lets the subgroup variant of
  // the reduction stay unprivatized and still merge correctly.
  if (i < kPrivateExtentsBlobs) {
    for (uint c = 1u; c < kExtentsCopies; ++c) {
      extents[ExtentsSlot(i, c, pc.capacity)] = e;
    }
  }
}
