#version 450
// 8-bit-storage Thresholded, subgroup-aggregated counter (see
// blob_diff_body.glsl's AGGREGATE_APPEND_COUNTER comment) - the variant
// GpuDetector picks when the device has both storageBuffer8BitAccess and
// subgroup ballot in COMPUTE (true of the Mali-G610 target). See
// blob_diff_body.glsl for the shader itself.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "common.glsl"

layout(std430, binding = 0) readonly buffer Thresholded { uint8_t thresholded[]; };
#define THRESHOLDED_AT(i) (thresholded[(i)])
#define AGGREGATE_APPEND_COUNTER

#include "blob_diff_body.glsl"
