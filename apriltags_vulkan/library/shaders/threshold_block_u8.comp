#version 450
// block_filter.comp and threshold_u8.comp in one pass: each thread takes one 4x4 block, folds the
// 3x3 neighbourhood of block min/max (InternalBlockFilter) and thresholds the block's pixels.
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x_id = 0, local_size_x = 16, local_size_y_id = 1, local_size_y = 16) in;
// Non-zero: the contrast floor is the one noise_floor.comp wrote, not the push constant.
layout(constant_id = 3) const uint kAdaptiveFloor = 0u;
// Non-zero: lists each 64 x 4 pixel cell that holds a block with contrast in cell_list (see
// cell_list.glsl; the count is cell_list[0]).
layout(constant_id = 4) const uint kSparse = 0u;

layout(std430, binding = 0) readonly buffer DecimatedImage { uint8_t decimated[]; };
layout(std430, binding = 1) readonly buffer UnfilteredMinMax { uint minmax_unfiltered[]; };
layout(std430, binding = 2) writeonly buffer Thresholded { uint8_t thresholded[]; };
layout(std430, binding = 3) readonly buffer Floor { uint contrast_floor[]; };
layout(std430, binding = 4) buffer ActiveCells { uint active_cells[]; };
layout(std430, binding = 5) buffer CellList { uint cell_list[]; };
// Bindings 0 and 2 viewed as words of 4 pixels, for blocks whose rows are aligned words.
layout(std430, binding = 0) readonly buffer DecimatedWords { uint decimated_words[]; };
layout(std430, binding = 2) writeonly buffer ThresholdedWords { uint thresholded_words[]; };

layout(push_constant) uniform PushConstants {
  uint decimated_width;
  uint decimated_height;
  uint min_white_black_diff;
  uint block_width;
  uint block_height;
} pc;

// The workgroup's block min/max with a one-block halo, staged once; out-of-image entries hold the
// identity for the min/max fold. Sized for workgroups up to 32 x 32.
shared uint tile[34 * 34];

void main() {
  uint bx = gl_GlobalInvocationID.x;
  uint by = gl_GlobalInvocationID.y;
  const uint wx = gl_WorkGroupSize.x;
  const uint wy = gl_WorkGroupSize.y;
  const uint tw = wx + 2u;
  const int base_x = int(gl_WorkGroupID.x * wx) - 1;
  const int base_y = int(gl_WorkGroupID.y * wy) - 1;
  for (uint i = gl_LocalInvocationIndex; i < tw * (wy + 2u); i += wx * wy) {
    int rx = base_x + int(i % tw);
    int ry = base_y + int(i / tw);
    bool inside = rx >= 0 && ry >= 0 && rx < int(pc.block_width) && ry < int(pc.block_height);
    tile[i] = inside ? minmax_unfiltered[uint(ry) * pc.block_width + uint(rx)] : 0x00ffu;
  }
  memoryBarrierShared();
  barrier();
  if (bx >= pc.block_width || by >= pc.block_height) return;

  uint mn = 255u;
  uint mx = 0u;
  for (uint j = 0u; j < 3u; ++j) {
    for (uint i = 0u; i < 3u; ++i) {
      uint v = tile[(gl_LocalInvocationID.y + j) * tw + gl_LocalInvocationID.x + i];
      mn = min(mn, v & 0xffu);
      mx = max(mx, (v >> 8u) & 0xffu);
    }
  }

  bool ambiguous = mx - mn < (kAdaptiveFloor != 0u ? contrast_floor[0] : pc.min_white_black_diff);
  uint thresh = mn + (mx - mn) / 2u;
  if (kSparse != 0u && !ambiguous) {
    uint cell = by * ((pc.block_width + 15u) / 16u) + (bx >> 4u);
    if (atomicOr(active_cells[cell], 1u) == 0u) cell_list[1u + atomicAdd(cell_list[0], 1u)] = cell;
  }
  uint x_end = min(bx * 4u + 4u, pc.decimated_width);
  uint y_end = min(by * 4u + 4u, pc.decimated_height);
  if ((pc.decimated_width & 3u) == 0u) {
    for (uint y = by * 4u; y < y_end; ++y) {
      uint w = (y * pc.decimated_width) / 4u + bx;
      uint d = decimated_words[w];
      uint out_word = 0u;
      for (uint k = 0u; k < 4u; ++k) {
        uint result = ambiguous ? 127u : ((((d >> (8u * k)) & 0xFFu) > thresh) ? 255u : 0u);
        out_word |= result << (8u * k);
      }
      thresholded_words[w] = out_word;
    }
    return;
  }
  for (uint y = by * 4u; y < y_end; ++y) {
    uint row = y * pc.decimated_width;
    for (uint x = bx * 4u; x < x_end; ++x) {
      uint result = ambiguous ? 127u : ((uint(decimated[row + x]) > thresh) ? 255u : 0u);
      thresholded[row + x] = uint8_t(result);
    }
  }
}
