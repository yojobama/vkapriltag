#version 450
// Down-samples the full resolution grayscale image by an integer factor
// (kDecimation - GpuDetector::DetectorConfig::decimation), keeping one
// representative pixel per kDecimation x kDecimation block (matches
// CudaToGreyscaleAndDecimateHalide's decimation, which copies rather than
// averages).
//
// The source image arrives PACKED, four 8-bit pixels per uint32 in raster
// order, and is unpacked here. That keeps the upload at one byte per pixel
// instead of the four it used to cost (the host previously widened every
// pixel to a uint32 in a scalar loop, then uploaded 4x the bytes, purely to
// avoid depending on an optional device feature).
//
// Unpacking with a shift rather than relying on 8-bit storage means this
// needs no VK_KHR_8bit_storage / storageBuffer8BitAccess support, so it works
// on parts that lack it. The byte order within each word is the natural
// little-endian one produced by memcpy'ing the source image, which is what
// every Vulkan-capable platform uses.
//
// Dispatched 2D so dx/dy come straight from gl_GlobalInvocationID.xy instead
// of a runtime `%`/`/` by decimated_width - Mali (Valhall) has no integer
// divide instruction, so that recovery used to cost a software divide
// sequence per invocation, once per pixel.
layout(local_size_x_id = 0, local_size_x = 16, local_size_y_id = 1, local_size_y = 16) in;
// Fixed for this detector's whole lifetime, resolved at pipeline-creation
// time - see GpuDetector.cpp's comment on why this is a specialization
// constant rather than a push constant (a runtime divide/multiply by a
// non-compile-time value on a device with no integer divide instruction).
layout(constant_id = 3) const uint kDecimation = 2u;

layout(std430, binding = 0) readonly buffer GrayImage { uint gray_packed[]; };
layout(std430, binding = 1) writeonly buffer DecimatedImage { uint decimated[]; };

layout(push_constant) uniform PushConstants {
  uint decimated_width;
  uint decimated_height;
} pc;

void main() {
  uint dx = gl_GlobalInvocationID.x;
  uint dy = gl_GlobalInvocationID.y;
  if (dx >= pc.decimated_width || dy >= pc.decimated_height) return;

  uint sx = dx * kDecimation;
  uint sy = dy * kDecimation;

  uint linear = sy * (pc.decimated_width * kDecimation) + sx;
  uint word = gray_packed[linear >> 2u];
  decimated[dy * pc.decimated_width + dx] = (word >> ((linear & 3u) * 8u)) & 0xFFu;
}
