#version 450
// 32-bit-per-pixel Thresholded, subgroup-aggregated counter (see
// blob_diff_body.glsl's AGGREGATE_APPEND_COUNTER comment). See
// blob_diff_body.glsl for the shader itself.
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "common.glsl"

layout(std430, binding = 0) readonly buffer Thresholded { uint thresholded[]; };
#define THRESHOLDED_AT(i) (thresholded[(i)])
#define AGGREGATE_APPEND_COUNTER

#include "blob_diff_body.glsl"
