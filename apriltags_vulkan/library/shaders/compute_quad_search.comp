#version 450
// A9 stage 4: GPU port of DoFitQuads' C(10,4) combinatorial search
// (QuadDecode.cpp, FitQuadForBlob lines ~399-469) over stage 3's selected
// peak indices, picking the 4 that form the lowest-total-error quad.
//
// One workgroup per blob, sized to EXACTLY one subgroup (see
// compute_moments_prefix.comp's comment for why). The search naturally
// splits across the m0 dimension (at most kCacheDim = 7 distinct values):
// each lane owns one m0 and runs its own complete, independent m1/m2/m3
// search (no cross-lane data dependency within that work - m0's own
// cached m0-m1 row only needs pidx[] and cs[], both read-only), then a
// small subgroup reduction (subgroupMin + a ballot to find which lane
// achieved it) picks the global winner. Measured necessary: an earlier
// single-thread-per-blob version cost ~1.57 ms of the ~4.2 ms A9 added to
// the Mali G610 pipeline (of a ~11.3 ms pre-A9 baseline) - the most
// expensive single stage after compute_moments_prefix.comp, despite
// looking small (up to 7*8*9*10 heavily-pruned iterations) - it runs
// entirely on one lane, once per blob, with no parallelism at all.
//
// Outputs the 4 winning LOCAL point indices (0-based within the blob, same
// convention as stage 3's point_indices/CPU's FitQuadResult::indices) and
// a valid flag - NOT the final quad corners. Reconstructing corners from 4
// known indices via ReadMomentsWindow + FitLine's line-intersection math is
// cheap (four blobs' worth of work per accepted quad, not per boundary
// point), so that step is left on the CPU exactly as it works today; this
// stage replaces the expensive O(total boundary points) search, not the
// O(1) corner reconstruction after it.
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#include "int64_emu.glsl"
#include "line_fit_moments.glsl"
#include "subgroup_ballot128.glsl"

layout(local_size_x_id = 0, local_size_x = 16) in;

layout(std430, binding = 0) readonly buffer BlobPointOffsets { uint blob_point_offsets[]; };
layout(std430, binding = 1) readonly buffer Moments { GpuLineFitMomentsRaw cs[]; };
// From stage 3 (compute_peaks.comp): up to 10 selected LOCAL point indices
// per blob, ascending, valid up to NumSelected[blob].
layout(std430, binding = 2) readonly buffer PeakIndices { uint peak_indices[]; };
layout(std430, binding = 3) readonly buffer NumSelected { uint num_selected[]; };
// 4 LOCAL point indices per blob (garbage if ValidOut[blob] == 0).
layout(std430, binding = 4) writeonly buffer BestIndicesOut { uint best_indices_out[]; };
layout(std430, binding = 5) writeonly buffer ValidOut { uint valid_out[]; };
// The 4 corresponding window moments (indices[k] to indices[(k+1)%4]),
// mirroring FitQuadForBlob's final `result.moments[k] =
// ReadMomentsWindow(...)` step - computed here so the CPU tail needs no
// further cs[]/per-point access at all to reconstruct the quad's actual
// corners (just FitLine's line-intersection math on 4 known moments).
layout(std430, binding = 6) writeonly buffer BestMomentsOut { GpuLineFitMomentsRaw best_moments_out[]; };

layout(push_constant) uniform PushConstants {
  uint num_blobs;
  float max_line_fit_mse;
  float cos_critical_rad;
} pc;

const float kFloatMax = 3.402823466e+38;
const uint kNMaxima = 10u;
const uint kCacheDim = 7u;  // kNMaxima - 3

// Port of ReadMomentsWindow (QuadDecode.cpp) - identical to stage 2's
// (compute_window_error.comp), including the same index0 > 0 guard fix
// (see that shader's comment; QuadDecode.cpp itself was fixed the same
// way - see fix/read-moments-window-oob).
GpuLineFitMomentsRaw ReadMomentsWindowLocal(uint begin, uint total_points, uint index0,
                                            uint index1) {
  GpuLineFitMomentsRaw result;
  if (index0 < index1) {
    result = cs[begin + index1];
    if (index0 > 0u) {
      result = SubMoments(result, cs[begin + index0 - 1u]);
    }
    result.N = int(index1 - index0 + 1u);
  } else {
    GpuLineFitMomentsRaw lfsz = cs[begin + total_points - 1u];
    result = lfsz;
    if (index0 > 0u) {
      result = SubMoments(lfsz, cs[begin + index0 - 1u]);
    }
    result = AddMoments(result, cs[begin + index1]);
    result.N = int(total_points - index0 + index1 + 1u);
  }
  return result;
}

// Port of FitLine (QuadDecode.cpp) - only the pieces DoFitQuads actually
// uses (err, mse, and the unit normal "lineparam23"; lineparam01 is never
// read in the combinatorial search itself, so it isn't computed here).
struct FitLineResult23 {
  float err;
  float mse;
  vec2 normal;
};

FitLineResult23 FitLine23(GpuLineFitMomentsRaw m) {
  I64 Cxx = Sub64(Mul64By32(GetMxx(m), m.W), Mul32x32To64(m.Mx, m.Mx));
  I64 Cxy = Sub64(Mul64By32(GetMxy(m), m.W), Mul32x32To64(m.Mx, m.My));
  I64 Cyy = Sub64(Mul64By32(GetMyy(m), m.W), Mul32x32To64(m.My, m.My));

  // Same exact-64-bit-before-float ordering as line_fit_moments.glsl's
  // FitLineError, for the same catastrophic-cancellation reason.
  float diff_f = ToFloat64(Sub64(Cxx, Cyy));    // Cxx - Cyy
  float sum_f = ToFloat64(Add64(Cxx, Cyy));     // Cxx + Cyy
  float cxy2_f = ToFloat64(Add64(Cxy, Cxy));    // 2 * Cxy

  float hypot_cached = length(vec2(diff_f, cxy2_f));
  float eight_w_squared = float(m.W) * float(m.W) * 8.0;
  float eig_small = (sum_f - hypot_cached) / eight_w_squared;

  float nx1 = diff_f - hypot_cached;
  float ny1 = cxy2_f;
  float M1v = nx1 * nx1 + ny1 * ny1;
  float nx2 = cxy2_f;
  float ny2 = -diff_f - hypot_cached;  // Cyy - Cxx == -(Cxx - Cyy)
  float M2v = nx2 * nx2 + ny2 * ny2;

  vec2 n = (M1v > M2v) ? vec2(nx1, ny1) : vec2(nx2, ny2);

  FitLineResult23 r;
  r.err = float(m.N) * eig_small;
  r.mse = eig_small;
  r.normal = normalize(n);
  return r;
}

void main() {
  uint b = gl_WorkGroupID.x;
  if (b >= pc.num_blobs) return;

  uint tid = gl_SubgroupInvocationID;
  uint K = num_selected[b];

  uint pidx[kNMaxima];
  uint begin = 0u, n = 0u;
  float local_best_error = kFloatMax;
  uint local_best0 = 0u, local_best1 = 0u, local_best2 = 0u, local_best3 = 0u;

  // Only lanes [0, kCacheDim) own an m0; the rest contribute nothing
  // (local_best_error stays kFloatMax) but still participate uniformly in
  // every subgroup op below.
  if (K >= 4u && tid < kCacheDim) {
    begin = (b == 0u) ? 0u : blob_point_offsets[b - 1u];
    n = blob_point_offsets[b] - begin;
    for (uint k = 0u; k < K; ++k) pidx[k] = peak_indices[b * kNMaxima + k];

    uint m0 = tid;
    // This lane's own row of the m0-m1 cache - only m1 in (m0, kNMaxima-2)
    // is ever read below, so no larger cache table is needed.
    float error_m0_row[kCacheDim];
    vec2 params_m0_row[kCacheDim];
    for (uint j = 0u; j < kCacheDim; ++j) error_m0_row[j] = kFloatMax;

    for (uint m1 = m0 + 1u; m1 < kNMaxima - 2u; ++m1) {
      if (m1 >= K) continue;
      FitLineResult23 fl = FitLine23(ReadMomentsWindowLocal(begin, n, pidx[m0], pidx[m1]));
      float err01 = fl.err;
      if (fl.mse > pc.max_line_fit_mse) err01 = kFloatMax;
      error_m0_row[m1 - 1u] = err01;
      params_m0_row[m1 - 1u] = fl.normal;
    }

    for (uint m1 = m0 + 1u; m1 < kNMaxima - 2u; ++m1) {
      float errm0m1 = error_m0_row[m1 - 1u];
      if (errm0m1 == kFloatMax) continue;
      vec2 paramsm0m1 = params_m0_row[m1 - 1u];

      for (uint m2 = m1 + 1u; m2 < kNMaxima - 1u; ++m2) {
        if (m2 >= K) break;
        FitLineResult23 fl12 = FitLine23(ReadMomentsWindowLocal(begin, n, pidx[m1], pidx[m2]));
        if (fl12.mse > pc.max_line_fit_mse) continue;

        float dot = paramsm0m1.x * fl12.normal.x + paramsm0m1.y * fl12.normal.y;
        if (abs(dot) > pc.cos_critical_rad) continue;

        for (uint m3 = m2 + 1u; m3 < kNMaxima; ++m3) {
          if (m3 >= K) break;

          FitLineResult23 fl23 = FitLine23(ReadMomentsWindowLocal(begin, n, pidx[m2], pidx[m3]));
          if (fl23.mse > pc.max_line_fit_mse) continue;

          FitLineResult23 fl30 = FitLine23(ReadMomentsWindowLocal(begin, n, pidx[m3], pidx[m0]));
          if (fl30.mse > pc.max_line_fit_mse) continue;

          float total = errm0m1 + fl12.err + fl23.err + fl30.err;
          if (total < local_best_error) {
            local_best_error = total;
            local_best0 = m0;
            local_best1 = m1;
            local_best2 = m2;
            local_best3 = m3;
          }
        }
      }
    }
  }

  // Subgroup reduction: find the global minimum and which lane holds it.
  // subgroupMin is a native op (float, no struct decomposition needed);
  // exact-value ties are vanishingly unlikely with floats and, if they
  // happen, FindLSB128 picks the lowest lane id deterministically rather
  // than being undefined.
  float global_best_error = subgroupMin(local_best_error);
  bool is_winner = local_best_error == global_best_error;
  uvec4 winner_ballot = subgroupBallot(is_winner);
  uint winner_lane = AnyBits128(winner_ballot) ? FindLSB128(winner_ballot) : 0u;

  uint out_m0 = subgroupShuffle(local_best0, winner_lane);
  uint out_m1 = subgroupShuffle(local_best1, winner_lane);
  uint out_m2 = subgroupShuffle(local_best2, winner_lane);
  uint out_m3 = subgroupShuffle(local_best3, winner_lane);
  uint winner_begin = subgroupShuffle(begin, winner_lane);
  uint winner_n = subgroupShuffle(n, winner_lane);

  if (tid != 0u) return;

  if (global_best_error == kFloatMax ||
      !(global_best_error < pc.max_line_fit_mse * float(winner_n))) {
    valid_out[b] = 0u;
    return;
  }

  // pidx[] (an array, per-lane private storage) was never shuffled - only
  // the 4 winning m0..m3 indices are needed here, and every lane (lane 0
  // included) can read peak_indices[] directly, so there's no need to
  // reconstruct the winner's whole pidx[] array.
  uint out_base = b * 4u;
  uint best_local[4] = uint[4](peak_indices[b * kNMaxima + out_m0], peak_indices[b * kNMaxima + out_m1],
                               peak_indices[b * kNMaxima + out_m2], peak_indices[b * kNMaxima + out_m3]);

  valid_out[b] = 1u;
  best_indices_out[out_base + 0u] = best_local[0];
  best_indices_out[out_base + 1u] = best_local[1];
  best_indices_out[out_base + 2u] = best_local[2];
  best_indices_out[out_base + 3u] = best_local[3];

  for (uint k = 0u; k < 4u; ++k) {
    best_moments_out[out_base + k] =
        ReadMomentsWindowLocal(winner_begin, winner_n, best_local[k], best_local[(k + 1u) % 4u]);
  }
}
