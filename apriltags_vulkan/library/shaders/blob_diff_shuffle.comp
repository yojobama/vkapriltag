#version 450
// As blob_diff.comp with neighbour codes taken from other lanes (sparse dispatch only);
// scalar append counter variant, Thresholded as uint per pixel;
// blob_diff_u8.comp is the uint8_t variant. The shader is in blob_diff_body.glsl.
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_shuffle : require
#define BLOB_DIFF_SHUFFLE
#include "common.glsl"

layout(std430, binding = 6) readonly buffer Thresholded { uint thresholded[]; };
#define THRESHOLDED_AT(i) (thresholded[(i)])

#include "blob_diff_body.glsl"
