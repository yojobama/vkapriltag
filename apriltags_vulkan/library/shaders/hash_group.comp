#version 450
// Assigns every boundary point a hash-table slot for its (rep0, rep1) pair.
//
// The insert is lock-free and spin-free: a slot holds `owner + 1` (0 = empty),
// where owner is the claimant point's index. A thread that loses the
// atomicCompSwap compares keys against the winner, whose key was written by
// blob_diff.comp in an earlier dispatch. The winning thread is the slot's
// unique claimant and assigns its 1-based raw blob id from raw_blob_counter
// (ids are distinct, not in slot order).
layout(local_size_x_id = 0, local_size_x = 256) in;

// One uvec2 per point: the probe compares the whole key with one aligned 8-byte load.
layout(std430, binding = 0) readonly buffer Keys { uvec2 keys[]; };
layout(std430, binding = 1) buffer HashOwner { uint hash_owner[]; };
layout(std430, binding = 2) writeonly buffer PointSlot { uint point_slot[]; };
layout(std430, binding = 3) writeonly buffer SlotDense { uint slot_dense[]; };
layout(std430, binding = 4) buffer RawBlobCounter { uint raw_blob_counter; };
layout(std430, binding = 5) buffer DropCounter { uint drop_counter; };
// Point count read from this buffer when count_from_buffer is set (indirect
// dispatch, see build_indirect_args.comp), otherwise from the push constant.
layout(std430, binding = 6) readonly buffer CountBuf { uint count_buf; };

layout(push_constant) uniform PushConstants {
  uint count;
  uint table_mask;   // table size - 1; table size is a power of two
  uint max_probes;
  uint count_from_buffer;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= (pc.count_from_buffer != 0u ? count_buf : pc.count)) return;

  uvec2 k = keys[i];

  // 64 -> 32 bit murmur-style mix.
  uint h = k.x * 0x9E3779B1u + k.y * 0x85EBCA6Bu;
  h ^= h >> 16; h *= 0x7FEB352Du; h ^= h >> 15; h *= 0x846CA68Bu; h ^= h >> 16;
  h &= pc.table_mask;

  for (uint probe = 0u; probe < pc.max_probes; ++probe) {
    uint owner = hash_owner[h];
    if (owner == 0u) {
      uint prev = atomicCompSwap(hash_owner[h], 0u, i + 1u);
      if (prev == 0u) {
        // Won the slot: unique claimant. Number it.
        uint dense = atomicAdd(raw_blob_counter, 1u);
        slot_dense[h] = dense + 1u;
      }
      owner = (prev == 0u) ? (i + 1u) : prev;
    }
    uint o = owner - 1u;
    if (keys[o] == k) {
      point_slot[i] = h;
      return;
    }
    h = (h + 1u) & pc.table_mask;
  }
  // Probe chain exhausted: drop the point and count it.
  atomicAdd(drop_counter, 1u);
  point_slot[i] = 0xFFFFFFFFu;
}
