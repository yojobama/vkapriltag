#version 450
// Marks each decimated pixel that is its own union-find root (i.e. the
// canonical representative of a raw blob) with a 1, all others with 0. An
// inclusive scan of this array (scan_block.comp / scan_add_offsets.comp)
// then turns it into a dense, 1-based blob id at every root position:
// root_dense_id[r] == 1 + (number of roots at index < r).
//
// blob_diff.comp uses this to translate raw union-find roots (pixel indices
// in [0, pixels)) into dense ids before building the boundary-point sort
// key, shrinking it from ~log2(pixels) bits to ~log2(actual root count)
// bits. The mapping is strictly increasing in the original root index, so
// it preserves the relative order (and therefore the grouping) of any two
// roots - the sort's behavior is unchanged, only the key is narrower.
layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Parent { uint parent[]; };
layout(std430, binding = 1) writeonly buffer Flags { uint flags[]; };
layout(std430, binding = 2) readonly buffer BlobSize { uint blob_size[]; };

layout(push_constant) uniform PushConstants {
  uint dw;
  uint dh;
  uint min_blob_pixels;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.dw * pc.dh) return;
  // Rank ONLY the roots a boundary point can ever name. blob_diff.comp
  // refuses to emit a point whose blob is smaller than min_blob_pixels, so
  // roots below that threshold are unreachable from the sort key - yet they
  // dominate the root count (a 1080p frame has ~154k roots but only a few
  // thousand blobs of >= 24 pixels), and it is the root COUNT that sets the
  // key width and hence the radix pass count.
  flags[i] = (parent[i] == i && blob_size[i] >= pc.min_blob_pixels) ? 1u : 0u;
}
