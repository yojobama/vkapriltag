#version 450
// As uf_merge_u8.comp, with each thread covering 4 pixels of a row read as words; the decimated
// width must be a multiple of 4.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(std430, binding = 1) readonly buffer Thresholded { uint8_t thresholded[]; };
layout(std430, binding = 1) readonly buffer ThresholdedWords { uint thresholded_words[]; };
#define THRESHOLDED_AT(index) uint(thresholded[index])
#define THRESHOLDED_WORD(w) (thresholded_words[(w)])

#include "uf_merge_body.glsl"
