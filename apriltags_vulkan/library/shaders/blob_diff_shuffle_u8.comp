#version 450
// As blob_diff_shuffle.comp, with Thresholded stored as uint8_t per pixel.
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#define BLOB_DIFF_SHUFFLE
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#include "common.glsl"

layout(std430, binding = 6) readonly buffer Thresholded { uint8_t thresholded[]; };
#define THRESHOLDED_AT(i) (thresholded[(i)])

#include "blob_diff_body.glsl"
