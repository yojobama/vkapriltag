#version 450
// Subgroup-aggregated variant of reduce_extents_hash.comp, selected at runtime
// when the subgroup supports BALLOT, ARITHMETIC and SHUFFLE in COMPUTE.
//
// Reduce by key: each iteration takes the first remaining lane as leader,
// reduces the lanes sharing its key (identity elements stand in for the rest)
// and lets the leader issue the atomics. At most popcount(valid lanes)
// iterations. Ballots are uvec4 (subgroup_ballot128.glsl) as subgroups can
// exceed 32 lanes.
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#include "common.glsl"
#include "subgroup_ballot128.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Compacted { uint compacted[]; };
layout(std430, binding = 1) readonly buffer PointSlot { uint point_slot[]; };
layout(std430, binding = 2) readonly buffer SlotDense { uint slot_dense[]; };
layout(std430, binding = 3) buffer Extents { MinMaxExtentsGpu extents[]; };
// Same device-side count as the scalar variants.
layout(std430, binding = 5) readonly buffer CountBuf { uint count_buf; };

layout(push_constant) uniform PushConstants {
  uint count;
  uint max_raw_blobs;
  uint count_from_buffer;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  bool is_active = i < (pc.count_from_buffer != 0u ? count_buf : pc.count);

  // bi is 0xFFFFFFFFu for lanes that are out of range, unmatched or dropped
  // (the sentinel hash_group.comp's point_slot[] uses).
  uint bi = 0xFFFFFFFFu;
  int x = 0, y = 0, gx = 0, gy = 0;
  if (is_active) {
    uint slot = point_slot[i];
    if (slot != 0xFFFFFFFFu) {
      uint bi_raw = slot_dense[slot];
      if (bi_raw != 0u && bi_raw <= pc.max_raw_blobs) {
        bi = bi_raw - 1u;
        QBPoint p = UnpackQBPoint(compacted[i]);
        x = int(p.x);
        y = int(p.y);
        gx = p.gx;
        gy = p.gy;
      }
    }
  }
  bool valid = (bi != 0xFFFFFFFFu);

  uvec4 remaining = subgroupBallot(valid);

  while (AnyBits128(remaining)) {
    uint leaderLane = FindLSB128(remaining);
    uint leaderKey = subgroupShuffle(bi, leaderLane);
    bool sameKey = valid && (bi == leaderKey);
    uvec4 sameKeyMask = subgroupBallot(sameKey);

    int redMinX = subgroupMin(sameKey ? x : 0x7FFFFFFF);
    int redMinY = subgroupMin(sameKey ? y : 0x7FFFFFFF);
    int redMaxX = subgroupMax(sameKey ? x : (-2147483647));
    int redMaxY = subgroupMax(sameKey ? y : (-2147483647));
    int redGxSum = subgroupAdd(sameKey ? gx : 0);
    int redGySum = subgroupAdd(sameKey ? gy : 0);
    int redPxgxPygy = subgroupAdd(sameKey ? (x * gx + y * gy) : 0);
    uint redCount = PopCount128(sameKeyMask);

    if (gl_SubgroupInvocationID == leaderLane) {
      atomicMin(extents[leaderKey].min_x, redMinX);
      atomicMin(extents[leaderKey].min_y, redMinY);
      atomicMax(extents[leaderKey].max_x, redMaxX);
      atomicMax(extents[leaderKey].max_y, redMaxY);
      atomicAdd(extents[leaderKey].count, redCount);
      // No != 0 guard on the gx/gy sums: they are already reduced across the
      // subgroup, so zero sums are rare.
      atomicAdd(extents[leaderKey].gx_sum, redGxSum);
      atomicAdd(extents[leaderKey].gy_sum, redGySum);
      atomicAdd(extents[leaderKey].pxgx_plus_pygy_sum, redPxgxPygy);
    }
    remaining = AndNot128(remaining, sameKeyMask);
  }
}
