#version 450
// Copies each selected blob's point count into a max_blobs-sized buffer,
// zero-padded beyond the selected count, for the inclusive scan (scan_block.comp
// / scan_add_offsets.comp). Reads the count from the GPU counter buffer.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Selected { MinMaxExtentsGpu selected[]; };
layout(std430, binding = 1) readonly buffer SelectedCounter { uint num_selected; };
layout(std430, binding = 2) writeonly buffer Counts { uint counts[]; };

layout(push_constant) uniform PushConstants {
  uint capacity;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.capacity) return;
  uint n = min(num_selected, pc.capacity);
  counts[i] = (i < n) ? selected[i].count : 0u;
}
