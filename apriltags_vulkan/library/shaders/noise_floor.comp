#version 450
// Sets the frame's block contrast floor from its noise: the median 4x4 block range (most blocks are
// flat, so it is the sensor noise) times kScale / 10, at least min_white_black_diff. One workgroup.
layout(local_size_x_id = 0, local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer UnfilteredMinMax { uint minmax_unfiltered[]; };
layout(std430, binding = 1) writeonly buffer Floor { uint contrast_floor[]; };

layout(push_constant) uniform PushConstants {
  uint block_count;
  uint min_white_black_diff;
  uint scale_tenths;
} pc;

shared uint histogram[256];

void main() {
  for (uint b = gl_LocalInvocationID.x; b < 256u; b += gl_WorkGroupSize.x) histogram[b] = 0u;
  memoryBarrierShared();
  barrier();
  for (uint i = gl_LocalInvocationID.x; i < pc.block_count; i += gl_WorkGroupSize.x) {
    uint v = minmax_unfiltered[i];
    atomicAdd(histogram[((v >> 8u) & 0xffu) - (v & 0xffu)], 1u);
  }
  memoryBarrierShared();
  barrier();
  if (gl_LocalInvocationID.x == 0u) {
    uint seen = 0u;
    uint median = 0u;
    for (uint b = 0u; b < 256u; ++b) {
      seen += histogram[b];
      if (2u * seen >= pc.block_count) {
        median = b;
        break;
      }
    }
    contrast_floor[0] = min(255u, max(pc.min_white_black_diff, (median * pc.scale_tenths + 9u) / 10u));
  }
}
