#version 450
// As uf_init_scan.comp, with Thresholded stored as uint8_t per pixel.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(std430, binding = 1) readonly buffer Thresholded { uint8_t thresholded[]; };
#define THRESHOLDED_AT(i) (thresholded[(i)])
// Binding 1 viewed as words of 4 codes.
layout(std430, binding = 1) readonly buffer ThresholdedWords { uint thresholded_words[]; };
#define THRESHOLDED_WORD(w) (thresholded_words[(w)])

#include "uf_init_scan_body.glsl"
