#version 450
// Consumes the sorted, per-raw-blob QBPoint array and the raw->selected
// blob remap produced by select_blobs.comp. For every point belonging to a
// selected blob, computes its angle around the blob centroid (matching
// AddThetaToIndexPoint) and writes an IPoint into the output array at a
// DETERMINISTIC position: base_offset[sel_bi] + (its rank within this raw
// blob's contiguous run in sorted[]). This packs every selected blob's
// points into one contiguous range of the output array with no atomic-
// derived scatter, which is what lets sort_points_local.comp sort each
// blob's points with a single workgroup instead of one flat global sort
// keyed on (blob_index, theta).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

#define PI 3.14159265358979323846

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Sorted { QBPoint sorted[]; };
layout(std430, binding = 1) readonly buffer RawBlobIndex { uint raw_blob_index[]; };
layout(std430, binding = 2) readonly buffer Remap { uint remap[]; };
layout(std430, binding = 3) readonly buffer Selected { MinMaxExtentsGpu selected[]; };
layout(std430, binding = 4) writeonly buffer Output { IPoint output_points[]; };
layout(std430, binding = 5) buffer Counter { uint counter; };
layout(std430, binding = 6) readonly buffer BlobPointOffsets { uint blob_point_offsets[]; };

layout(push_constant) uniform PushConstants {
  uint count;
  uint capacity;
  uint max_raw_blobs;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;

  QBPoint p = sorted[i];
  if (p.valid == 0u) return;

  uint raw_bi = min(raw_blob_index[i], pc.max_raw_blobs - 1u);
  uint sel_bi = remap[raw_bi];
  if (sel_bi == 0xFFFFFFFFu) return;

  MinMaxExtentsGpu e = selected[sel_bi];
  float cx = (float(e.min_x) + float(e.max_x)) * 0.5 + 0.05118;
  float cy = (float(e.min_y) + float(e.max_y)) * 0.5 + -0.028581;

  float theta = (atan(float(p.y) - cy, float(p.x) - cx) + float(PI)) * 8e6;
  int theta_int = int(round(theta));
  uint theta_key = uint(max(theta_int, 0));

  // blob_point_offsets[sel_bi] is the INCLUSIVE scan of selected[].count (see
  // extract_blob_counts.comp), so subtracting this blob's own count gives its
  // exclusive base offset. i - e.starting_offset is this point's 0-based rank
  // within the blob's contiguous run in sorted[] (starting_offset was copied
  // from the raw blob's extents by select_blobs.comp), so the sum is a
  // stable, collision-free position with no atomic needed for placement.
  uint base = blob_point_offsets[sel_bi] - e.count;
  uint pos = base + (i - e.starting_offset);
  if (pos >= pc.capacity) return;

  atomicAdd(counter, 1u);  // total point count only; no longer used to place

  IPoint out_pt;
  out_pt.blob_index = sel_bi;
  out_pt.x = p.x;
  out_pt.y = p.y;
  out_pt.gx = p.gx;
  out_pt.gy = p.gy;
  out_pt.theta_key = theta_key;
  out_pt.pad0 = 0u;
  out_pt.pad1 = 0u;
  output_points[pos] = out_pt;
}
