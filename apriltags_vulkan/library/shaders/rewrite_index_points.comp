#version 450
// Consumes the sorted, per-raw-blob QBPoint array and the raw->selected
// blob remap produced by select_blobs.comp. For every point belonging to a
// selected blob, computes its angle around the blob centroid (matching
// AddThetaToIndexPoint) and atomically appends an IPoint into the output
// array, together with a (blob_index, theta) sort key for the next
// bitonic_sort.comp pass (which orders each blob's points around its
// perimeter, required for windowed line fitting).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

#define PI 3.14159265358979323846

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Sorted { QBPoint sorted[]; };
layout(std430, binding = 1) readonly buffer RawBlobIndex { uint raw_blob_index[]; };
layout(std430, binding = 2) readonly buffer Remap { uint remap[]; };
layout(std430, binding = 3) readonly buffer Selected { MinMaxExtentsGpu selected[]; };
layout(std430, binding = 4) writeonly buffer Output { IPoint output_points[]; };
layout(std430, binding = 5) buffer Counter { uint counter; };
layout(std430, binding = 6) writeonly buffer KeysHi { uint keys_hi[]; };
layout(std430, binding = 7) writeonly buffer KeysLo { uint keys_lo[]; };
layout(std430, binding = 8) writeonly buffer Payload { uint payload[]; };

layout(push_constant) uniform PushConstants {
  uint count;
  uint capacity;
  uint max_raw_blobs;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;

  QBPoint p = sorted[i];
  if (p.valid == 0u) return;

  uint raw_bi = min(raw_blob_index[i], pc.max_raw_blobs - 1u);
  uint sel_bi = remap[raw_bi];
  if (sel_bi == 0xFFFFFFFFu) return;

  MinMaxExtentsGpu e = selected[sel_bi];
  float cx = (float(e.min_x) + float(e.max_x)) * 0.5 + 0.05118;
  float cy = (float(e.min_y) + float(e.max_y)) * 0.5 + -0.028581;

  float theta = (atan(float(p.y) - cy, float(p.x) - cx) + float(PI)) * 8e6;
  int theta_int = int(round(theta));
  uint theta_key = uint(max(theta_int, 0));

  uint pos = atomicAdd(counter, 1u);
  if (pos >= pc.capacity) return;

  IPoint out_pt;
  out_pt.blob_index = sel_bi;
  out_pt.x = p.x;
  out_pt.y = p.y;
  out_pt.gx = p.gx;
  out_pt.gy = p.gy;
  out_pt.theta_key = theta_key;
  out_pt.pad0 = 0u;
  out_pt.pad1 = 0u;
  output_points[pos] = out_pt;

  keys_hi[pos] = sel_bi;
  keys_lo[pos] = theta_key;
  payload[pos] = pos;
}
