#version 450
// 32-bit-per-pixel Thresholded, scalar (non-aggregated) counter - the
// always-safe default. See blob_diff_body.glsl for the shader itself and
// blob_diff_u8.comp / blob_diff_subgroup.comp / blob_diff_u8_subgroup.comp
// for the variants GpuDetector picks on devices with storageBuffer8BitAccess
// and/or subgroup ballot in COMPUTE.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(std430, binding = 0) readonly buffer Thresholded { uint thresholded[]; };
#define THRESHOLDED_AT(i) (thresholded[(i)])

#include "blob_diff_body.glsl"
