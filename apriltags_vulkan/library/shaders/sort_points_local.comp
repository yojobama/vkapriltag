#version 450
// 32-bit-per-pixel DecimatedImage variant - see sort_points_local_body.glsl
// for the shader itself and sort_points_local_u8.comp for the 8-bit-storage
// sibling GpuDetector picks on devices that support it.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(std430, binding = 3) readonly buffer DecimatedImage { uint decimated[]; };
#define DECIMATED_AT(i) (decimated[(i)])

#include "sort_points_local_body.glsl"
