#version 450
// Places each surviving point at the next free slot of its blob's contiguous
// output range (per-blob cursor), so a blob's points are contiguous for
// sort_points_local.comp. Order within a blob is nondeterministic and is
// overwritten by the angular sort. The total written equals the last entry of
// the inclusive-scanned blob point offsets.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Compacted { uint compacted[]; };
layout(std430, binding = 1) readonly buffer PointSlot { uint point_slot[]; };
layout(std430, binding = 2) readonly buffer SlotDense { uint slot_dense[]; };
layout(std430, binding = 3) readonly buffer Remap { uint remap[]; };
layout(std430, binding = 4) readonly buffer Selected { MinMaxExtentsGpu selected[]; };
layout(std430, binding = 5) readonly buffer BlobPointOffsets { uint blob_point_offsets[]; };
layout(std430, binding = 6) buffer BlobCursor { uint blob_cursor[]; };
layout(std430, binding = 7) writeonly buffer Output { IPoint output_points[]; };
// Point count read from this buffer when count_from_buffer is set, else from
// the push constant.
layout(std430, binding = 8) readonly buffer CountBuf { uint count_buf; };

layout(push_constant) uniform PushConstants {
  uint count;
  uint capacity;
  uint max_raw_blobs;
  uint count_from_buffer;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= (pc.count_from_buffer != 0u ? count_buf : pc.count)) return;

  uint slot = point_slot[i];
  if (slot == 0xFFFFFFFFu) return;

  uint bi = slot_dense[slot];
  if (bi == 0u || bi > pc.max_raw_blobs) return;
  bi -= 1u;

  uint sel = remap[bi];
  if (sel == 0xFFFFFFFFu) return;

  QBPoint p = UnpackQBPoint(compacted[i]);

  MinMaxExtentsGpu e = selected[sel];
  float cx = (float(e.min_x) + float(e.max_x)) * 0.5 + 0.05118;
  float cy = (float(e.min_y) + float(e.max_y)) * 0.5 + -0.028581;

  // Pseudo-angle in [0, 4) instead of atan2: monotonic in the true angle,
  // counterclockwise from +x, with no transcendental.
  float dx = float(p.x) - cx;
  float dy = float(p.y) - cy;
  float d = abs(dx) + abs(dy);
  float ratio = (d > 0.0) ? (dy / d) : 0.0;
  float pseudo_angle = (dx >= 0.0) ? ((dy >= 0.0) ? ratio : (4.0 + ratio)) : (2.0 - ratio);

  // Scaled to 20 bits (max 1,000,000 at pseudo_angle 4); sort_points_local.comp
  // packs it with a 12-bit local index.
  int theta_int = int(round(pseudo_angle * 2.5e5));
  uint theta_key = uint(max(theta_int, 0));

  uint rank = atomicAdd(blob_cursor[sel], 1u);
  if (rank >= e.count) return;
  uint pos = blob_point_offsets[sel] - e.count + rank;
  if (pos >= pc.capacity) return;

  IPoint out_pt;
  out_pt.blob_index = sel;
  out_pt.xy = PackXY(p.x, p.y);
  out_pt.theta_key = theta_key;
  output_points[pos] = out_pt;
}
