#version 450
// Identical to threshold.comp except DecimatedImage and Thresholded are both
// uint8_t per pixel instead of uint - selected at runtime (GpuDetector::
// ShaderPath) on devices that report storageBuffer8BitAccess. Both buffers
// change together, not independently: this shader is the one place that
// reads decimated_buf_ AND writes thresholded_buf_ in the same dispatch, so
// there is no clean way to make only one of the two 8-bit here - see
// decimate_u8.comp's comment for the general rationale.
//
// Thresholded is still logically three-valued (0/127/255) even packed into
// a byte - no change to that encoding, just the storage width.
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x_id = 0, local_size_x = 16, local_size_y_id = 1, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer DecimatedImage { uint8_t decimated[]; };
layout(std430, binding = 1) readonly buffer FilteredMinMax { uint minmax_filtered[]; };
layout(std430, binding = 2) writeonly buffer Thresholded { uint8_t thresholded[]; };

layout(push_constant) uniform PushConstants {
  uint decimated_width;
  uint decimated_height;
  uint min_white_black_diff;
  uint block_width;
} pc;

void main() {
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  if (x >= pc.decimated_width || y >= pc.decimated_height) return;
  uint i = y * pc.decimated_width + x;

  // block_width is passed explicitly rather than recomputed as
  // decimated_width/4u: decimated_width need not be a multiple of 4 (only
  // the source image's width/height are guaranteed even), so the host's
  // ceil-rounded block grid (GpuDetector::block_width_) is the only correct
  // stride into minmax_filtered[].
  uint packed = minmax_filtered[(x / 4u) + (y / 4u) * pc.block_width];
  uint mn = packed & 0xffu;
  uint mx = (packed >> 8u) & 0xffu;

  uint result;
  if (mx - mn < pc.min_white_black_diff) {
    result = 127u;
  } else {
    uint thresh = mn + (mx - mn) / 2u;
    result = (uint(decimated[i]) > thresh) ? 255u : 0u;
  }
  thresholded[i] = uint8_t(result);
}
