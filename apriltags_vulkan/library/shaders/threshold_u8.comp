#version 450
// As threshold.comp, with DecimatedImage and Thresholded stored as uint8_t per pixel (the encoding
// stays 0/127/255).
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(std430, binding = 0) readonly buffer DecimatedImage { uint8_t decimated[]; };
layout(std430, binding = 2) writeonly buffer Thresholded { uint8_t thresholded[]; };
#define DECIMATED_AT(i) (decimated[(i)])
#define STORE_THRESHOLDED(i, v) (thresholded[(i)] = uint8_t(v))

#include "threshold_body.glsl"
