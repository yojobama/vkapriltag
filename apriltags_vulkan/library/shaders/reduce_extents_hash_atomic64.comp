// atomicAdd covers count and pxgx_plus_pygy_sum. reduce_extents_hash.comp is
// the fallback.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#define USE_INT64_ATOMIC 1
#include "common.glsl"
#include "reduce_extents_hash_body.glsl"
