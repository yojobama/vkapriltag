#version 450
// Folds reduce_extents_hash.comp's private accumulator copies into the
// canonical extents[bi] (layout in common.glsl's ExtentsSlot). Dispatched
// indirectly over the raw blob count. Min/max/sum fold exactly, and untouched
// copies hold init_extents.comp's identity.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) buffer Extents { MinMaxExtentsGpu extents[]; };

layout(push_constant) uniform PushConstants {
  uint capacity;
} pc;

void main() {
  uint bi = gl_GlobalInvocationID.x;
  if (bi >= pc.capacity) return;
  // Blobs past the privatised range were accumulated into the canonical slot.
  if (bi >= kPrivateExtentsBlobs) return;

  MinMaxExtentsGpu acc = extents[bi];
  for (uint c = 1u; c < kExtentsCopies; ++c) {
    MinMaxExtentsGpu o = extents[ExtentsSlot(bi, c, pc.capacity)];
    acc.min_x = min(acc.min_x, o.min_x);
    acc.min_y = min(acc.min_y, o.min_y);
    acc.max_x = max(acc.max_x, o.max_x);
    acc.max_y = max(acc.max_y, o.max_y);
    acc.count += o.count;
    acc.gx_sum += o.gx_sum;
    acc.gy_sum += o.gy_sum;
    acc.pxgx_plus_pygy_sum += o.pxgx_plus_pygy_sum;
  }
  extents[bi] = acc;
}
