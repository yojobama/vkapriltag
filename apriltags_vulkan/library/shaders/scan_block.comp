#version 450
// Single-workgroup-block inclusive prefix sum (Hillis-Steele, shared memory).
// Each workgroup scans its own gl_WorkGroupSize.x elements and writes the block
// total to block_sums[group_id]; scan_add_offsets.comp adds the scanned block
// totals back. The block size is a specialisation constant, and the host must
// use the same value as the scan chain's fan-out divisor.
layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InputBuf { uint input_values[]; };
layout(std430, binding = 1) writeonly buffer OutputBuf { uint output_values[]; };
layout(std430, binding = 2) writeonly buffer BlockSums { uint block_sums[]; };

layout(push_constant) uniform PushConstants {
  uint count;
} pc;

// Sized for the largest block (1024 entries); only the first gl_WorkGroupSize.x are used.
shared uint temp[1024];

void main() {
  uint tid = gl_LocalInvocationID.x;
  uint gid = gl_GlobalInvocationID.x;

  uint value = (gid < pc.count) ? input_values[gid] : 0u;
  temp[tid] = value;
  barrier();

  for (uint offset = 1u; offset < gl_WorkGroupSize.x; offset <<= 1u) {
    uint addend = (tid >= offset) ? temp[tid - offset] : 0u;
    barrier();
    temp[tid] += addend;
    barrier();
  }

  if (gid < pc.count) {
    output_values[gid] = temp[tid];
  }
  // The last lane holds the block total (out-of-range lanes contribute 0). Not
  // written for a single workgroup, where block_sums aliases output_values and
  // would overwrite element 0.
  if (gl_NumWorkGroups.x > 1u && tid == gl_WorkGroupSize.x - 1u) {
    block_sums[gl_WorkGroupID.x] = temp[tid];
  }
}
