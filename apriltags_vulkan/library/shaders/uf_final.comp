#version 450
// Computes the pixel count of each blob (indexed by root label) using
// atomics.  Mirrors the "blob size computed in parallel using atomics" side
// effect of the CUDA BKE labeling implementation.  Must run after the union
// find has fully converged (last uf_compress pass) and after
// union_markers_size has been zero-initialized.
layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Parent { uint parent[]; };
layout(std430, binding = 1) buffer BlobSize { uint blob_size[]; };

layout(push_constant) uniform PushConstants {
  uint width;
  uint height;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  uint total = pc.width * pc.height;
  if (i >= total) return;
  atomicAdd(blob_size[parent[i]], 1u);
}
