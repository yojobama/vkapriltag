#version 450
// 32-bit-per-pixel Thresholded - the always-safe default. See
// uf_final_body.glsl for the shader itself, and uf_final_u8.comp for the
// variant GpuDetector picks on devices with storageBuffer8BitAccess.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(std430, binding = 2) readonly buffer Thresholded { uint thresholded[]; };
#define THRESHOLDED_AT(i) (thresholded[(i)])

#include "uf_final_body.glsl"
