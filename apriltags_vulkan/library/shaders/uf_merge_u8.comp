#version 450
// 8-bit-thresholded variant, selected on devices reporting
// storageBuffer8BitAccess - see decimate_u8.comp. See uf_merge_body.glsl.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(std430, binding = 1) readonly buffer Thresholded { uint8_t thresholded[]; };
#define THRESHOLDED_AT(index) uint(thresholded[index])

#include "uf_merge_body.glsl"
