#version 450
// reduce_extents.comp, keyed off the hash slot instead of off a run in a
// sorted array. Identical arithmetic; the only difference is where the raw
// blob index comes from - there is no sorted array to offset into,
// scatter_index_points.comp places each point with a per-blob cursor
// instead, and MinMaxExtentsGpu no longer even carries a starting_offset
// field (see common.glsl).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Compacted { uint compacted[]; };
layout(std430, binding = 1) readonly buffer PointSlot { uint point_slot[]; };
layout(std430, binding = 2) readonly buffer SlotDense { uint slot_dense[]; };
layout(std430, binding = 3) buffer Extents { MinMaxExtentsGpu extents[]; };
layout(std430, binding = 4) readonly buffer ResolvedCounts { uint resolved_counts[]; };

// pc.count is gone: this shader is now dispatched INDIRECTLY, so the host
// never learns the boundary-point count and cannot pass it. The count comes
// from resolved_counts[0], written by build_indirect_args.comp from the same
// device counter, clamped identically to how the host used to clamp it. See
// that shader for why the host read-back was worth removing.
layout(push_constant) uniform PushConstants {
  uint max_raw_blobs;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= resolved_counts[0]) return;

  uint slot = point_slot[i];
  if (slot == 0xFFFFFFFFu) return;

  uint bi = slot_dense[slot];
  if (bi == 0u || bi > pc.max_raw_blobs) return;
  bi -= 1u;

  QBPoint p = UnpackQBPoint(compacted[i]);

  int x = int(p.x);
  int y = int(p.y);
  atomicMin(extents[bi].min_x, x);
  atomicMin(extents[bi].min_y, y);
  atomicMax(extents[bi].max_x, x);
  atomicMax(extents[bi].max_y, y);
  atomicAdd(extents[bi].count, 1u);
  atomicAdd(extents[bi].gx_sum, p.gx);
  atomicAdd(extents[bi].gy_sum, p.gy);
  atomicAdd(extents[bi].pxgx_plus_pygy_sum, x * p.gx + y * p.gy);
}
