#version 450
// 32-bit-per-pixel Thresholded - the always-safe default. See
// label_pixels_body.glsl for the shader itself, and label_pixels_u8.comp for
// the variant GpuDetector picks on devices with storageBuffer8BitAccess.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(std430, binding = 2) readonly buffer Thresholded { uint thresholded[]; };
#define THRESHOLDED_AT(i) (thresholded[(i)])

#include "label_pixels_body.glsl"
