#version 450
// Flags every occupied hash slot with a 1. An inclusive scan of this array
// then gives each occupied slot a dense, 1-based raw blob id - the same role
// mark_heads.comp + its scan played for the sorted array, but over the table
// (a fixed, small size) instead of over every boundary point.
layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer HashOwner { uint hash_owner[]; };
layout(std430, binding = 1) writeonly buffer SlotDense { uint slot_dense[]; };

layout(push_constant) uniform PushConstants { uint table_size; } pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.table_size) return;
  slot_dense[i] = (hash_owner[i] != 0u) ? 1u : 0u;
}
