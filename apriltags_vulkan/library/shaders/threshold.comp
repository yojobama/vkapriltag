#version 450
// DecimatedImage and Thresholded as uint per pixel; threshold_u8.comp is the uint8_t variant.
// The shader is in threshold_body.glsl.
#extension GL_GOOGLE_include_directive : require

layout(std430, binding = 0) readonly buffer DecimatedImage { uint decimated[]; };
layout(std430, binding = 2) writeonly buffer Thresholded { uint thresholded[]; };
#define DECIMATED_AT(i) (decimated[(i)])
#define STORE_THRESHOLDED(i, v) (thresholded[(i)] = (v))

#include "threshold_body.glsl"
