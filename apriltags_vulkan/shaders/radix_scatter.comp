#version 450
// Pass 3 of 3 of one LSD radix-sort digit pass: the stable scatter.
//
// Each element's destination is
//
//   offsets[digit * num_blocks + block]  +  rank of this element within its
//                                          block, among elements of the same
//                                          digit, in original order
//
// STABILITY IS NOT OPTIONAL. LSD radix sort is only correct if every pass
// preserves the relative order of elements sharing a digit - that is what
// carries the ordering established by the lower digits. So the per-block rank
// must be a true in-order rank, which rules out the obvious
// `atomicAdd(cursor[digit], 1)` (whose result depends on arrival order).
//
// The ranks for all 16 buckets are produced by ONE prefix sum, not sixteen.
// Each lane contributes a single 1 placed in the byte belonging to its bucket
// of a uvec4 (4 words x 4 bytes = 16 byte-wide counters), and the whole uvec4
// is scanned with ordinary integer addition. No byte can carry into its
// neighbour because a block holds at most RADIX_MAX_BLOCK (128) elements, so
// no counter can exceed 128 < 256. The exclusive scan's byte for a lane's own
// bucket is precisely its stable in-block rank.
//
// The obvious alternative - one prefix sum per bucket - costs 16x the shared
// memory traffic and barriers, and measured slower than a comparison sort.
layout(local_size_x_id = 0, local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer SrcHi { uint src_hi[]; };
layout(std430, binding = 1) readonly buffer SrcLo { uint src_lo[]; };
layout(std430, binding = 2) readonly buffer SrcPay { uint src_pay[]; };
layout(std430, binding = 3) writeonly buffer DstHi { uint dst_hi[]; };
layout(std430, binding = 4) writeonly buffer DstLo { uint dst_lo[]; };
layout(std430, binding = 5) writeonly buffer DstPay { uint dst_pay[]; };
layout(std430, binding = 6) readonly buffer Offsets { uint offsets[]; };

layout(push_constant) uniform PushConstants {
  uint n;
  uint shift;
  uint use_hi;
  uint num_blocks;
} pc;

// Byte-packed counters cannot overflow only while the workgroup is <= 128
// invocations; the host must specialize local_size_x to at most this.
#define RADIX_MAX_BLOCK 128

shared uvec4 s_counts[RADIX_MAX_BLOCK];

void main() {
  uint W = gl_WorkGroupSize.x;
  uint tid = gl_LocalInvocationID.x;
  uint i = gl_WorkGroupID.x * W + tid;

  uint hi = 0u, lo = 0u, pay = 0u;
  uint digit = 0u;  // kept in range for inactive lanes; their contribution is 0
  bool lane_used = i < pc.n;

  uvec4 mine = uvec4(0u);
  if (lane_used) {
    hi = src_hi[i];
    lo = src_lo[i];
    pay = src_pay[i];
    uint word = (pc.use_hi != 0u) ? hi : lo;
    digit = (word >> pc.shift) & 0xFu;
    // One in the byte owned by this bucket: word digit/4, byte digit%4.
    mine[digit >> 2u] = 1u << ((digit & 3u) * 8u);
  }

  s_counts[tid] = mine;
  barrier();

  // Inclusive scan over all 16 byte-counters at once.
  for (uint off = 1u; off < W; off <<= 1u) {
    uvec4 addend = (tid >= off) ? s_counts[tid - off] : uvec4(0u);
    barrier();
    s_counts[tid] += addend;
    barrier();
  }

  if (lane_used) {
    // Exclusive scan == inclusive minus this lane's own contribution.
    uvec4 excl = s_counts[tid] - mine;
    uint rank = (excl[digit >> 2u] >> ((digit & 3u) * 8u)) & 0xFFu;

    uint dest = offsets[digit * pc.num_blocks + gl_WorkGroupID.x] + rank;
    dst_hi[dest] = hi;
    dst_lo[dest] = lo;
    dst_pay[dest] = pay;
  }
}
