#version 450
// Computes up to 4 QuadBoundaryPoint candidates per interior pixel, one per
// diamond-shaped neighbor connection (E, SE, S, SW), and appends the valid
// ones straight into the compacted output.
//
// This used to write a DENSE 4-plane array of (width-2)*(height-2) QBPoints
// each - 66 MB at 1080p, overwhelmingly empty entries - which a separate
// compact_qbp.comp pass then re-read in its entirety to pick out the valid
// ones. That cost ~132 MB of memory traffic per frame plus a 2M-thread
// dispatch, to move a few hundred thousand real points. Appending directly
// with the same atomic counter compaction already used removes the dense
// array, its traffic, and that whole second pass.
//
// Ordering: the append order is nondeterministic (it depends on atomic
// arrival order), exactly as it already was when compact_qbp.comp did the
// appending. Nothing depends on it - the points are immediately sorted by
// (rep0, rep1), and MinMaxExtentsGpu::starting_offset is not consumed by the
// CPU tail.
//
// IMPORTANT: QBPoint.x/.y store the *un-decimated* coordinate (matching
// CUDA's QuadBoundaryPoint::x()/y(): base_x()*2+dx(), base_y()*2+dy()), not
// the raw decimated pixel index - every downstream consumer (extents
// min/max + centroid via MinMaxExtentsGpu::cx()/cy()'s 0.05118/-0.028581
// sub-pixel offsets, line-fit moments, theta) assumes this doubled,
// half-integer-accurate convention.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Thresholded { uint thresholded[]; };
layout(std430, binding = 1) readonly buffer Parent { uint parent[]; };
layout(std430, binding = 2) readonly buffer BlobSize { uint blob_size[]; };
layout(std430, binding = 3) writeonly buffer Compacted { QBPoint compacted[]; };
layout(std430, binding = 4) buffer Counter { uint counter; };
layout(std430, binding = 5) writeonly buffer KeysHi { uint keys_hi[]; };
layout(std430, binding = 6) writeonly buffer KeysLo { uint keys_lo[]; };
layout(std430, binding = 7) writeonly buffer Payload { uint payload[]; };

layout(push_constant) uniform PushConstants {
  uint width;
  uint height;
  uint min_blob_pixels;
  uint capacity;
} pc;

// Appends one boundary point, together with its (rep0, rep1) sort key and the
// identity payload index the gather pass needs.
void append(uint rep_a, uint rep_b, uint px, uint py, int gx, int gy) {
  uint pos = atomicAdd(counter, 1u);
  if (pos >= pc.capacity) return;

  QBPoint p;
  p.rep0 = min(rep_a, rep_b);
  p.rep1 = max(rep_a, rep_b);
  p.x = px;
  p.y = py;
  p.gx = gx;
  p.gy = gy;
  p.valid = 1u;
  p.pad0 = 0u;
  compacted[pos] = p;

  keys_hi[pos] = p.rep0;
  keys_lo[pos] = p.rep1;
  payload[pos] = pos;
}

void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint iw = pc.width - 2u;
  uint ih = pc.height - 2u;
  if (gid >= iw * ih) return;

  uint ox = gid % iw;
  uint oy = gid / iw;
  uint x = ox + 1u;
  uint y = oy + 1u;

  uint idx = x + y * pc.width;
  uint v0 = thresholded[idx];
  uint rep0 = parent[idx];

  // Ambiguous pixel, or a blob too small to matter: contributes nothing.
  if (v0 == 127u || blob_size[rep0] < pc.min_blob_pixels) return;

  // Neighbor samples. The dispatch covers interior pixels only
  // (x in [1, width-1), y in [1, height-1)), so all five are in range.
  uint idxE = idx + 1u;
  uint idxSE = idx + pc.width + 1u;
  uint idxS = idx + pc.width;
  uint idxSW = idx + pc.width - 1u;
  uint idxW = idx - 1u;

  uint vE = thresholded[idxE];
  uint vSE = thresholded[idxSE];
  uint vS = thresholded[idxS];
  uint vSW = thresholded[idxSW];
  uint vW = thresholded[idxW];

  uint repE = parent[idxE];
  uint repSE = parent[idxSE];
  uint repS = parent[idxS];
  uint repSW = parent[idxSW];
  uint repW = parent[idxW];

  // Connections 0 (E), 1 (SE), 2 (S): emit a point if the two pixels straddle
  // a black/white boundary.
  if (v0 + vE == 255u && blob_size[repE] >= pc.min_blob_pixels) {
    append(rep0, repE, x * 2u + 1u, y * 2u, (vE > v0) ? 1 : -1, 0);
  }
  if (v0 + vSE == 255u && blob_size[repSE] >= pc.min_blob_pixels) {
    int g = (vSE > v0) ? 1 : -1;
    append(rep0, repSE, x * 2u + 1u, y * 2u + 1u, g, g);
  }
  if (v0 + vS == 255u && blob_size[repS] >= pc.min_blob_pixels) {
    append(rep0, repS, x * 2u, y * 2u + 1u, 0, (vS > v0) ? 1 : -1);
  }

  // Dedup check: if the West and South neighbors are both unambiguous and
  // differ from one another, the SW diagonal connection (3) would duplicate
  // the topological edge already captured by the West pixel's own SE (=our
  // South) diagonal connection, so skip emitting it.
  bool sw_is_duplicate = vW != 127u && vS != 127u && vS != vW && x != 1u &&
                         blob_size[repW] >= pc.min_blob_pixels &&
                         blob_size[repS] >= pc.min_blob_pixels;
  if (sw_is_duplicate) return;

  if (v0 + vSW == 255u && blob_size[repSW] >= pc.min_blob_pixels) {
    append(rep0, repSW, x * 2u - 1u, y * 2u + 1u, (vSW > v0) ? -1 : 1, (vSW > v0) ? 1 : -1);
  }
}
