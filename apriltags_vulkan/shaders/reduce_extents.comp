#version 450
// Reduces the sorted, per-boundary-pair-grouped QBPoint array into one
// MinMaxExtentsGpu entry per unique (rep0, rep1) blob pair, using atomics.
// This replaces CUB's DeviceReduce::ReduceByKey; the compact "raw blob
// index" for each point (computed by mark_heads.comp + an inclusive scan)
// tells us which extents[] slot to accumulate into, and is clamped
// defensively so a pathological input can never write out of bounds.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Sorted { QBPoint sorted[]; };
layout(std430, binding = 1) readonly buffer Heads { uint heads[]; };
layout(std430, binding = 2) readonly buffer RawBlobIndex { uint raw_blob_index[]; };
layout(std430, binding = 3) buffer Extents { MinMaxExtentsGpu extents[]; };

layout(push_constant) uniform PushConstants {
  uint count;
  uint max_raw_blobs;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;

  QBPoint p = sorted[i];
  if (p.valid == 0u) return;

  uint bi = min(raw_blob_index[i], pc.max_raw_blobs - 1u);

  if (heads[i] == 1u) {
    extents[bi].starting_offset = i;
    extents[bi].rep0 = p.rep0;
    extents[bi].rep1 = p.rep1;
  }

  int x = int(p.x);
  int y = int(p.y);
  atomicMin(extents[bi].min_x, x);
  atomicMin(extents[bi].min_y, y);
  atomicMax(extents[bi].max_x, x);
  atomicMax(extents[bi].max_y, y);
  atomicAdd(extents[bi].count, 1u);
  atomicAdd(extents[bi].gx_sum, p.gx);
  atomicAdd(extents[bi].gy_sum, p.gy);
  atomicAdd(extents[bi].pxgx_plus_pygy_sum, x * p.gx + y * p.gy);
}
