#version 450
// Initializes the raw per-blob extents accumulator array before
// reduce_extents.comp runs its atomic min/max/sum reduction.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) writeonly buffer Extents { MinMaxExtentsGpu extents[]; };

layout(push_constant) uniform PushConstants {
  uint capacity;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.capacity) return;

  MinMaxExtentsGpu e;
  e.min_x = 2147483647;
  e.min_y = 2147483647;
  e.max_x = -2147483647;
  e.max_y = -2147483647;
  e.starting_offset = 0u;
  e.count = 0u;
  e.gx_sum = 0;
  e.gy_sum = 0;
  e.pxgx_plus_pygy_sum = 0;
  e.rep0 = 0u;
  e.rep1 = 0u;
  e.pad0 = 0u;
  extents[i] = e;
}
