#version 450
// Compacts the dense 4-plane QBPoint array (produced by blob_diff.comp) down
// to only the valid entries, using an atomic counter for the output
// position. Also emits the parallel sort-key arrays (hi = rep0, lo = rep1)
// and an identity payload index, ready for bitonic_sort.comp.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Input { QBPoint input_points[]; };
layout(std430, binding = 1) writeonly buffer Compacted { QBPoint compacted[]; };
layout(std430, binding = 2) buffer Counter { uint counter; };
layout(std430, binding = 3) writeonly buffer KeysHi { uint keys_hi[]; };
layout(std430, binding = 4) writeonly buffer KeysLo { uint keys_lo[]; };
layout(std430, binding = 5) writeonly buffer Payload { uint payload[]; };

layout(push_constant) uniform PushConstants {
  uint total;
  uint capacity;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.total) return;

  QBPoint p = input_points[i];
  if (p.valid == 0u) return;

  uint pos = atomicAdd(counter, 1u);
  if (pos >= pc.capacity) return;

  compacted[pos] = p;
  keys_hi[pos] = p.rep0;
  keys_lo[pos] = p.rep1;
  payload[pos] = pos;
}
