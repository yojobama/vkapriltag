#version 450
// Initializes the union-find parent array: every pixel starts as its own
// root.  This replaces the CUDA implementation's block-based BKE init; we
// use a simple flat per-pixel Shiloach-Vishkin style union-find instead,
// which is algorithmically equivalent (produces the same connected
// components) and much easier to make portable across GPU vendors.
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Parent { uint parent[]; };

layout(push_constant) uniform PushConstants {
  uint width;
  uint height;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  uint total = pc.width * pc.height;
  if (i >= total) return;
  parent[i] = i;
}
