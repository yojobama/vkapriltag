#version 450
// Given a sorted-by-key QBPoint array, marks the first element of each run
// of identical (rep0, rep1) keys with a 1, everything else with a 0.  An
// inclusive scan of this array (see scan_block.comp) then directly yields a
// compact, 0-based "raw blob index" for every point (scan value - 1).
// Points with valid == 0 (padding left over from gather_generic.comp
// skipping out-of-range sorted entries) never start a new group; they are
// separately skipped entirely by reduce_extents.comp.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Sorted { QBPoint sorted[]; };
layout(std430, binding = 1) writeonly buffer Heads { uint heads[]; };

layout(push_constant) uniform PushConstants {
  uint count;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;

  QBPoint a = sorted[i];
  if (a.valid == 0u) {
    heads[i] = 0u;
    return;
  }

  if (i == 0u) {
    heads[i] = 1u;
    return;
  }
  QBPoint b = sorted[i - 1u];
  heads[i] = (b.valid == 0u || a.rep0 != b.rep0 || a.rep1 != b.rep1) ? 1u : 0u;
}
