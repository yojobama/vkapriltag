#version 450
// Down-samples the full resolution grayscale image by simply keeping every
// other row/column (matches CudaToGreyscaleAndDecimateHalide's decimation,
// which copies rather than averages).
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer GrayImage { uint gray[]; };
layout(std430, binding = 1) writeonly buffer DecimatedImage { uint decimated[]; };

layout(push_constant) uniform PushConstants {
  uint width;
  uint height;
} pc;

void main() {
  uint decimated_width = pc.width / 2u;
  uint decimated_height = pc.height / 2u;
  uint total = decimated_width * decimated_height;
  uint i = gl_GlobalInvocationID.x;
  if (i >= total) return;

  uint dx = i % decimated_width;
  uint dy = i / decimated_width;
  uint sx = dx * 2u;
  uint sy = dy * 2u;
  decimated[i] = gray[sy * pc.width + sx];
}
