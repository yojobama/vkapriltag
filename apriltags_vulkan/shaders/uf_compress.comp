#version 450
// Full path compression: every pixel's parent becomes its ultimate root.
// Run after each uf_merge.comp pass (and once more at the end) so that
// downstream shaders can treat `parent[i]` as the final blob label.
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Parent { uint parent[]; };

layout(push_constant) uniform PushConstants {
  uint width;
  uint height;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  uint total = pc.width * pc.height;
  if (i >= total) return;

  uint n = i;
  uint p = parent[n];
  while (p != n) {
    n = p;
    p = parent[n];
  }
  parent[i] = n;
}
