#version 450
// Generic "reorder by index" gather: dest[i] = src[payload[i]], operating on
// fixed-size records addressed as `stride` consecutive 32 bit words. Used to
// physically reorder QBPoint/IPoint arrays into sorted order after
// bitonic_sort.comp has sorted the (key, payload) arrays. Any payload value
// that isn't a valid index into `src` (i.e. sentinel padding left over from
// fill_max_key.comp for slots beyond the real element count) is skipped
// rather than dereferenced, since the padded region can otherwise contain
// arbitrarily large sentinel indices.
layout(local_size_x_id = 0, local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };
layout(std430, binding = 2) readonly buffer Payload { uint payload[]; };

layout(push_constant) uniform PushConstants {
  uint count;      // number of records to gather
  uint stride;     // record size in 32-bit words
  uint src_count;  // number of valid records in `src` (payload bounds check)
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;
  uint srcIndex = payload[i];
  if (srcIndex >= pc.src_count) return;
  for (uint w = 0u; w < pc.stride; ++w) {
    dst[i * pc.stride + w] = src[srcIndex * pc.stride + w];
  }
}
