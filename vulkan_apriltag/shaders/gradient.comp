#version 450

// Gradient computation using Sobel operator
// Computes both X and Y gradients simultaneously

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, r8ui) uniform readonly uimage2D input_image;
layout(set = 0, binding = 1, r16i) uniform writeonly iimage2D gradient_x;
layout(set = 0, binding = 2, r16i) uniform writeonly iimage2D gradient_y;
layout(set = 0, binding = 3, r16ui) uniform writeonly uimage2D gradient_magnitude;

layout(push_constant) uniform UniformBufferObject {
    uint width;
    uint height;
    float scale;
} ubo;

// Shared memory for efficient convolution
shared uint tile_data[18][18]; // 16x16 + 1 pixel border

void main() {
    uvec2 global_id = gl_GlobalInvocationID.xy;
    uvec2 local_id = gl_LocalInvocationID.xy;
    
    if (global_id.x >= ubo.width || global_id.y >= ubo.height) {
        return;
    }
    
    // Load tile data into shared memory with border
    uint local_x = local_id.x + 1;
    uint local_y = local_id.y + 1;
    
    // Load center pixel
    tile_data[local_y][local_x] = imageLoad(input_image, ivec2(global_id)).r;
    
    // Load border pixels
    if (local_id.x == 0) {
        int border_x = max(int(global_id.x) - 1, 0);
        tile_data[local_y][0] = imageLoad(input_image, ivec2(border_x, global_id.y)).r;
    }
    if (local_id.x == 15) {
        int border_x = min(int(global_id.x) + 1, int(ubo.width) - 1);
        tile_data[local_y][17] = imageLoad(input_image, ivec2(border_x, global_id.y)).r;
    }
    if (local_id.y == 0) {
        int border_y = max(int(global_id.y) - 1, 0);
        tile_data[0][local_x] = imageLoad(input_image, ivec2(global_id.x, border_y)).r;
    }
    if (local_id.y == 15) {
        int border_y = min(int(global_id.y) + 1, int(ubo.height) - 1);
        tile_data[17][local_x] = imageLoad(input_image, ivec2(global_id.x, border_y)).r;
    }
    
    // Load corner pixels
    if (local_id.x == 0 && local_id.y == 0) {
        int border_x = max(int(global_id.x) - 1, 0);
        int border_y = max(int(global_id.y) - 1, 0);
        tile_data[0][0] = imageLoad(input_image, ivec2(border_x, border_y)).r;
    }
    if (local_id.x == 15 && local_id.y == 0) {
        int border_x = min(int(global_id.x) + 1, int(ubo.width) - 1);
        int border_y = max(int(global_id.y) - 1, 0);
        tile_data[0][17] = imageLoad(input_image, ivec2(border_x, border_y)).r;
    }
    if (local_id.x == 0 && local_id.y == 15) {
        int border_x = max(int(global_id.x) - 1, 0);
        int border_y = min(int(global_id.y) + 1, int(ubo.height) - 1);
        tile_data[17][0] = imageLoad(input_image, ivec2(border_x, border_y)).r;
    }
    if (local_id.x == 15 && local_id.y == 15) {
        int border_x = min(int(global_id.x) + 1, int(ubo.width) - 1);
        int border_y = min(int(global_id.y) + 1, int(ubo.height) - 1);
        tile_data[17][17] = imageLoad(input_image, ivec2(border_x, border_y)).r;
    }
    
    barrier();
    
    // Skip border pixels for gradient computation
    if (global_id.x == 0 || global_id.x >= ubo.width - 1 ||
        global_id.y == 0 || global_id.y >= ubo.height - 1) {
        imageStore(gradient_x, ivec2(global_id), ivec4(0));
        imageStore(gradient_y, ivec2(global_id), ivec4(0));
        imageStore(gradient_magnitude, ivec2(global_id), uvec4(0));
        return;
    }
    
    // Sobel X kernel:
    // -1  0  1
    // -2  0  2
    // -1  0  1
    int gx = -int(tile_data[local_y-1][local_x-1]) + int(tile_data[local_y-1][local_x+1])
             -2*int(tile_data[local_y][local_x-1]) + 2*int(tile_data[local_y][local_x+1])
             -int(tile_data[local_y+1][local_x-1]) + int(tile_data[local_y+1][local_x+1]);
    
    // Sobel Y kernel:
    // -1 -2 -1
    //  0  0  0
    //  1  2  1
    int gy = -int(tile_data[local_y-1][local_x-1]) - 2*int(tile_data[local_y-1][local_x]) - int(tile_data[local_y-1][local_x+1])
             +int(tile_data[local_y+1][local_x-1]) + 2*int(tile_data[local_y+1][local_x]) + int(tile_data[local_y+1][local_x+1]);
    
    // Apply scaling
    gx = int(float(gx) * ubo.scale);
    gy = int(float(gy) * ubo.scale);
    
    // Calculate magnitude
    float magnitude = sqrt(float(gx * gx + gy * gy));
    uint mag_int = uint(clamp(magnitude, 0.0, 65535.0));
    
    // Store results
    imageStore(gradient_x, ivec2(global_id), ivec4(gx));
    imageStore(gradient_y, ivec2(global_id), ivec4(gy));
    imageStore(gradient_magnitude, ivec2(global_id), uvec4(mag_int));
}